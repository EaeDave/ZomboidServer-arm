NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://zomboid_panel:change-me@localhost:5432/zomboid_panel
SESSION_SECRET=replace-with-a-long-random-secret
AGENT_ENROLLMENT_TOKEN=replace-with-a-long-random-secret
AGENT_STALE_SECONDS=60
# Optional exact peer IPs for a reverse proxy that overwrites X-Forwarded-For.
# Leave empty to rate-limit using the direct socket peer address.
TRUSTED_PROXY_IPS=
# Local development only; production ignores both flags.
PZ_FAKE_AGENT=1
PZ_DEV_AUTH_BYPASS=1
# Set only when intentionally rendering the unauthenticated local dashboard.
VITE_DEV_AUTH_BYPASS=0
